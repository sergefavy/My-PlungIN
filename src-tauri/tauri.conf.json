{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My_PlugIN",
  "version": "0.2.3",
  "identifier": "com.myplugin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "My_PlugIN",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main",
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4MUU0MDcyNEJEQjMwRTYKUldUbU1OdExja0FlaUFzczFMb0hxMlZ2Nkt0Sldoc0tTdWJFNENqUldtSlRGaGFvTFpHTC9FcVYK",
      "endpoints": [
        "https://github.com/sergefavy/My-PlungIN/releases/latest/download/latest.json"
      ]
    }
  }
}
